```csharp
static AnimationClip CloneClip(AnimationClip src, string name) {
    var clip = new AnimationClip();
    clip.name = name;
    clip.frameRate = src.frameRate;
    var settings = AnimationUtility.GetAnimationClipSettings(src);
    AnimationUtility.SetAnimationClipSettings(clip, settings);
    foreach (var b in AnimationUtility.GetCurveBindings(src)) {
        var c = AnimationUtility.GetEditorCurve(src, b);
        if (c != null) AnimationUtility.SetCurve(clip, b, c);
    }
    foreach (var b in AnimationUtility.GetObjectReferenceCurveBindings(src)) {
        var k = AnimationUtility.GetObjectReferenceCurve(src, b);
        if (k != null) AnimationUtility.SetObjectReferenceCurve(clip, b, k);
    }
    return clip;
}
```
