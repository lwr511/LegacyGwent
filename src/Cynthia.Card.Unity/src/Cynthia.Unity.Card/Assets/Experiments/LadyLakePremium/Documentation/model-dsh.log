Implement parallel transport:
```python
def transport(pts, up0):
    n=len(pts)
    ts=[]
    for i in range(n):
        if i==0: t=(pts[1]-pts[0])
        elif i==n-1: t=(pts[-1]-pts[-2])
        else: t=(pts[i+1]-pts[i-1])
        ts.append(t.normalized())
    ups=[None]*n
    u = up0 - ts[0]*up0.dot(ts[0])
    if u.length<1e-5: u=Vector((0,1,0))
    ups[0]=u.normalized()
    for i in range(1,n):
        u = ups[i-1]
        u = u - ts[i]*u.dot(ts[i])
        if u.length<1e-6: u=Vector((0,1,0))
        ups[i]=u.normalized()
    return ts, ups
```

