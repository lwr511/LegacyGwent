public static Vector3 PivotLocalPosition()
{
    float half = HalfHeight(CameraDistance);
    float full = half * 2f;
    float u = ArtRegionX + ArtRegionW * .5f;
    float v = ArtRegionY + ArtRegionH * .5f;
    float dx = (u - .5f) * full;
    float dy = (v - .5f) * full - AppearanceOffsetY;
    return new Vector3(dx, dy, 0f);
}
