```
[InitializeOnLoad]
public static class LadyLakePremiumEditorBridge
{
    private const string Root = "Assets/Experiments/LadyLakePremium/Integration";
    private static double next;
    static LadyLakePremiumEditorBridge() { EditorApplication.update += Poll; }
    private static string Absolute(string relative) => Path.GetFullPath(relative);
    private static void Poll()
    {
        if (EditorApplication.timeSinceStartup < next) return;
        next = EditorApplication.timeSinceStartup + 1.0;
        if (EditorApplication.isCompiling || EditorApplication.isUpdating) return;
        string request = Path.Combine(Root, "editor-request.txt");
        if (!File.Exists(request)) return;
        string command = File.ReadAllText(request).Trim();
        if (command.Length == 0 || command[0] == '#') return;   // opt-in placeholder; do nothing
        File.Delete(request);
        try { Execute(command); File.WriteAllText(Path.Combine(Root,"editor-result.txt"), command + " OK " + DateTime.UtcNow.ToString("o")); }
        catch (Exception e) { File.WriteAllText(Path.Combine(Root,"editor-result.txt"), e.ToString()); Debug.LogException(e); }
    }
    private static void Execute(string command)
    {
        // command may be "capture <path>" or "build" etc.
        var parts = command.Split(new[]{' ','\t'}, StringSplitOptions.RemoveEmptyEntries);
        switch (parts[0].ToLowerInvariant())
        {
            case "build": LadyLakePremiumBuilder.Build(); break;
            case "open": LadyLakePremiumBuilder.Open(); break;
            case "play": if (!EditorApplication.isPlaying) EditorApplication.isPlaying = true; break;
            case "stop": if (EditorApplication.isPlaying) EditorApplication.isPlaying = false; break;
            case "capture": Capture(parts.Length>1?parts[1]:Path.Combine(Root,"capture.png")); break;
            case "validate": LadyLakePremiumBuilder.ValidateAndWrite(); break;
            case "status": WriteState(); break;
            default: throw new InvalidOperationException("Unsupported LadyLakePremium command: " + command);
        }
        WriteState();
    }
}
```
