Box-separable blur implementation:
```
public void Blur(int radius, int passes) {
  if (radius <= 0) return;
  float[] tmp = new float[w*h];
  for (int p=0;p<passes;p++){
    // horizontal
    for (int y=0;y<h;y++){
      for (int x=0;x<w;x++){
        float s=0; int n=0;
        for (int k=-radius;k<=radius;k++){ int xx=Mathf.Clamp(x+k,0,w-1); s+=v[y*w+xx]; n++; }
        tmp[y*w+x]=s/n;
      }
    }
    // vertical
    for (int y=0;y<h;y++){
      for (int x=0;x<w;x++){
        float s=0; int n=0;
        for (int k=-radius;k<=radius;k++){ int yy=Mathf.Clamp(y+k,0,h-1); s+=tmp[yy*w+x]; n++; }
        v[y*w+x]=s/n;
      }
    }
  }
}
```
Fine (small grids).

`FromTexture`: 
```
public static Field FromTexture(Texture2D tex, int w, int h, bool useAlpha) {
  Field f = new Field(); f.w=w; f.h=h; f.v=new float[w*h];
  Color32[] px = tex.GetPixels32();   // index 0 = bottom-left, row-major
  int tw = tex.width, th = tex.height;
  for (int y=0;y<h;y++){
    int y0 = y*th/h, y1 = Mathf.Max(y0+1, (y+1)*th/h);
    for (int x=0;x<w;x++){
      int x0 = x*tw/w, x1 = Mathf.Max(x0+1, (x+1)*tw/w);
      float s=0; int n=0;
      for (int py=y0; py<y1; py++) for (int pxx=x0; pxx<x1; pxx++){
         Color32 c = px[py*tw+pxx];
         s += useAlpha ? c.a/255f : (0.299f*c.r + 0.587f*c.g + 0.114f*c.b)/255f;
         n++;
      }
      f.v[y*w+x]= s/n;
    }
  }
  return f;
}
```
Note: iterating 128*183 cells × up to 8×8 pixels = fine. For 168x240: cell = 6.24x6.24 px → ~39 px per cell × 40320 cells = 1.57M iterations. Fine.

Sampling (bilinear) with u,v ∈ [0,1], v=0 = bottom = row 0 (since px index 0 is bottom-left and I filled y=0 from py=y0=0 = bottom rows). Good.

```
public float Sample(float u, float vv) {
  float fx = Mathf.Clamp01(u)*(w-1), fy = Mathf.Clamp01(vv)*(h-1);
  int x0=(int)fx, y0=(int)fy; int x1=Mathf.Min(x0+1,w-1), y1=Mathf.Min(y0+1,h-1);
  float tx=fx-x0, ty=fy-y0;
  float a=v[y0*w+x0], b=v[y0*w+x1], c=v[y1*w+x0], d=v[y1*w+x1];
  return Mathf.Lerp(Mathf.Lerp(a,b,tx), Mathf.Lerp(c,d,tx), ty);
}
```

