const int mw = 128, mh = 183;
float[] mask = new float[mw*mh];
for (int j=0;j<mh;j++){
  float v = (j+0.5f)/mh;
  float height = Mathf.SmoothStep(0f,1f, Mathf.Clamp01((0.86f - v)/(0.86f-0.30f)));
  for (int i=0;i<mw;i++){
    float u = (i+0.5f)/mw;
    float a = fgSway.Sample(u, v);
    float body = Mathf.SmoothStep(0f,1f, Mathf.Clamp01((a - 0.02f)/(0.30f-0.02f)));
    mask[j*mw+i] = Mathf.Clamp01(body*height);
  }
}
