private static void AccentGrid(Mesh mesh, int cols, int rows, float z, float tileU, float tileV,
    float maskFloor, float maskGain, float zoneLow, float zoneHigh)
{
    for j..: ty; fy; v=FrameV(fy);
       float zone = Mathf.SmoothStep(0f, 1f, Mathf.Clamp01((zoneHigh - v) / Mathf.Max(1e-4f, zoneHigh - zoneLow)));
       for i..: tx; fx; u=FrameU(fx);
          float luma = artLuma.Sample(u, v);
          float mask = maskFloor + maskGain * Mathf.SmoothStep(0f, 1f, Mathf.Clamp01((luma - 0.22f) / 0.40f));
          float alpha = Mathf.Clamp01(mask * zone);
          verts.Add(P(fx, fy, z));
          uvs.Add(new Vector2(tx * tileU, ty * tileV));
          colors.Add(new Color(1f, 1f, 1f, alpha));
}
