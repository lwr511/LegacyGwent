```python
def additive(base, tex_rgb, vcol_a, color_gain, tint, alpha_mult):
    out = base
    for ch, t in zip("RGB", tint):
        s = color_gain * t * alpha_mult
        layer = ImageChops.multiply(tex_rgb.getchannel(ch), vcol_a)
        layer = layer.point(lambda p, s=s: min(255, int(round(p * s))))
        channels = list(out.split())
        idx = "RGB".index(ch)
        channels[idx] = ImageChops.add(channels[idx], layer)
        out = Image.merge("RGB", channels)
    return out
```

